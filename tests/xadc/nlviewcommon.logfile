#CMD bind stroke-1 -action {}
#CMD bind stroke-nw-1 -action callback -echo_type line -echo_text {Zoom fit} -format (#1C1F28,#FFFFFF,1.0)
module list
#CMD bind stroke-ne-1 -action {}
#CMD bind stroke-se-1 -action zoom_in -echo_type rectangle -autoscroll -echo_text {Zoom area} -format (#1C1F28,#FFFFFF,1.0)
#CMD bind stroke-sw-1 -action zoom_in2 -echo_type line -echo_text {Zoom +%z} -format (#1C1F28,#FFFFFF,1.0)
#CMD bind stroke-nw-1 -action zoom_fit -echo_type line -echo_text {Zoom fit} -format (#1C1F28,#FFFFFF,1.0)
property rubberbandfontsize 20
property rubberbandcolor #1c1f28
module new first -nosplit
#  * Current module is first 
